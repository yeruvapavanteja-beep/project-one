# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agrismart_connect
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# File uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
